{
  "name": "carcare",
  "private": true,
  "version": "1.0.0-rc.1",
  "description": "CarCare residential car-wash management platform — release candidate for staging UAT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "npm run freeze:check && vitest run",
    "test:watch": "vitest",
    "freeze:check": "node scripts/ui-freeze.mjs --check",
    "freeze:update": "node scripts/ui-freeze.mjs --update",
    "verify:prod-build": "node scripts/verify-prod-build.mjs",
    "test:e2e": "playwright test",
    "check:deployment": "node scripts/check-deployment.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "3.9.1",
    "@supabase/supabase-js": "2.119.0",
    "@tanstack/react-query": "5.62.0",
    "clsx": "2.1.1",
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.54.0",
    "react-router-dom": "6.30.6",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.2.12",
    "@eslint/js": "9.17.0",
    "@playwright/test": "1.64.0",
    "@testing-library/dom": "10.4.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@testing-library/user-event": "14.5.2",
    "@types/node": "22.10.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.1.0",
    "globals": "15.13.0",
    "jsdom": "25.0.1",
    "postcss": "8.5.32",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.2",
    "typescript-eslint": "8.18.0",
    "vite": "5.4.21",
    "vitest": "2.1.9"
  }
}
