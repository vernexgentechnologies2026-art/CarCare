# Copy to .env (git-ignored) and fill in locally. Never commit real values.

# Data source: "mock" (default, no backend) or "supabase".
VITE_DATA_SOURCE=mock

# Required only when VITE_DATA_SOURCE=supabase. Public project URL and anon key only;
# NEVER place a service-role key in any VITE_ variable (it ships to the browser).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Public URL of the deployed photo gateway Worker (photos are stored in Cloudflare R2).
VITE_PHOTO_GATEWAY_URL=
# Residents sign in with mobile + password, stored in Supabase Auth as <mobile>@<this domain>.
# Turn OFF "Confirm email" in Supabase Auth. Optional; defaults to users.carcare.local.
VITE_AUTH_EMAIL_DOMAIN=

# Dev Role Switcher (on for the client demo): "false" hides it — use that for production, "true" shows it in any build,
# unset follows `npm run dev`. It never renders against the Supabase backend.
VITE_ENABLE_DEV_TOOLS=true
